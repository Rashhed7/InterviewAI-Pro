generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  avatar    String?

  role      UserRole @default(USER)

  plan      Plan @default(FREE)

  isActive  Boolean @default(true)

  isVerified Boolean @default(false)

  provider String @default("email")

  verificationToken String?
  verificationExpiry DateTime?

  resetPasswordToken String?
  resetPasswordExpiry DateTime?

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  interviews InterviewSession[]

  submissions CodingSubmission[]

  subscriptions Subscription[]

  payments Payment[]

  activityLogs ActivityLog[]
  freeInterviewCount Int @default(0)

  freeResumeCount Int @default(0)

  freeCodingCount Int @default(0)

  lastUsageReset DateTime @default(now())
}

model InterviewSession {
  id String @id @default(cuid())

  userId String

  title String

  role String

  difficulty String @default("Medium")

  score Int

  feedback String

  answersJson String @default("[]")

  duration Int @default(0)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodingSubmission {
  id String @id @default(cuid())

  userId String

  problemId String

  title String

  language String

  code String

  status String @default("Passed")

  score Int @default(0)

  executionTime Float?

  memory Float?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {

  id String @id @default(cuid())

  userId String

  plan Plan

  status SubscriptionStatus @default(ACTIVE)

  razorpaySubscriptionId String?

  razorpayCustomerId String?

  autoRenew Boolean @default(false)

  startDate DateTime @default(now())

  endDate DateTime

  cancelledAt DateTime?

  renewedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id String @id @default(cuid())

  userId String

  amount Float

  currency String @default("INR")

  provider String @default("RAZORPAY")

  razorpayOrderId String?

  razorpayPaymentId String?

  razorpaySignature String?

  transactionId String?

  invoiceId String?

  receiptId String?

  plan Plan

  status PaymentStatus @default(PENDING)

  paymentMethod String?

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id String @id @default(cuid())

  adminId String

  adminEmail String

  action String

  resource String

  details String

  oldValue Json?

  newValue Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model PlanFeature {

  id String @id @default(cuid())

  plan Plan

  maxInterviews Int

  maxResumeAnalysis Int

  maxCodingProblems Int

  cameraAnalysis Boolean

  voiceInterview Boolean

  codingArena Boolean

  aiFeedback Boolean

  analytics Boolean

  exportPdf Boolean
}